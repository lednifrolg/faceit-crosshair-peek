{
  "manifest_version": 3,
  "name": "FACEIT Crosshair Peek",
  "version": "1.0.0",
  "description": "Hover a match on a FACEIT profile to preview every player's CS2 crosshair, rendered from their share code.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.faceit.com/*"],
      "js": ["crosshairRenderer.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
